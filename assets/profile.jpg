<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0b"/>
      <stop offset="100%" style="stop-color:#161618"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00d4ff"/>
      <stop offset="100%" style="stop-color:#8b5cf6"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="400" height="400" fill="url(#bgGrad)"/>
  <circle cx="200" cy="200" r="150" fill="none" stroke="url(#accentGrad)" stroke-width="2" opacity="0.3"/>
  <circle cx="200" cy="200" r="100" fill="none" stroke="url(#accentGrad)" stroke-width="1" opacity="0.2" stroke-dasharray="10,10"/>
  <polygon points="200,80 260,180 360,180 290,250 320,350 200,300 80,350 110,250 40,180 140,180" fill="none" stroke="url(#accentGrad)" stroke-width="3" filter="url(#glow)" opacity="0.8"/>
  <text x="200" y="210" font-family="monospace" font-size="72" font-weight="700" fill="url(#accentGrad)" text-anchor="middle" letter-spacing="2">SC</text>
  <circle cx="200" cy="200" r="40" fill="url(#accentGrad)" opacity="0.1"/>
</svg>